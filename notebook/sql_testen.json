			{
				"cell_type": "code",
				"source": [
					"spark.sql(\"\"\"Create table sandbox.patiens_and_procedures as\n",
					"SELECT\n",
					"  patient.Id                         AS patient_id,\n",
					"  patient.First                      AS patient_first_name,\n",
					"  patient.Last                       AS patient_last_name,\n",
					"  patient.Race                       AS patient_race,\n",
					"  patient.State                      AS patient_state,\n",
					"  procedures.PATIENT                 AS procedures_patient_id,\n",
					"  procedures.DESCRIPTION             AS procedure_description,\n",
					"  procedures.BASE_COST               AS procedure_base_cost\n",
					"FROM sandbox.hospital_patients AS patient\n",
					"LEFT JOIN sandbox.hospital_data_procedures AS procedures\n",
					"  ON patient.Id = procedures.PATIENT\n",
					"\"\"\").show(truncate=False)\n",
					""
				],
				"execution_count": 28
