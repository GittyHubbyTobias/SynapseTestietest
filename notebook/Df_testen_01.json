				"source": [
					"from pyspark.sql import functions as F\n",
					"\n",
					"path = \"abfss://storagesynapsetestietest@accountsynapsetestietest.dfs.core.windows.net/Raw/oeps_echt_json_glossory.json\"\n",
					"raw = spark.read.text(path)\n",
					"\n",
					"\n",
					"json_text_df = raw.select(\n",
					"    F.concat_ws(\"\\n\", F.collect_list(\"value\")).alias(\"json_text\")\n",
					")\n",
					"\n",
					"display(json_text_df)  # dit is 1 rij met de complete JSON als tekst\n",
					"\n",
					"\n",
					"\n",
					"\n",
					"json_str = json_text_df.first()[\"json_text\"]\n",
					"\n",
					"df_json = spark.read.json(spark.sparkContext.parallelize([json_str]))\n",
					"display(df_json)\n",
					"df_json.printSchema()\n",
					"\n",
					"# df_json.toJSON().show(truncate=False)\n",
					"\n",
					"\n",
					"\n",
					""
				],
				"execution_count": 20
			},
			{
				"cell_type": "code",
				"source": [
					"\n",
					"(df_json\n",
					" .write\n",
					" .mode(\"overwrite\")\n",
					" .format(\"delta\")\n",
					" .saveAsTable(\"sandbox.silver_glossary_json\"))\n",
					""
				],
				"execution_count": 21
			},
			{
				"cell_type": "code",
				"metadata": {
					"collapsed": false
				},
				"source": [
					"spark.sql(\"SELECT * FROM sandbox.silver_glossary_json\").show\n",
					""
